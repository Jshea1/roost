];

function HomeScreen({ navigation }) {
  return (
    <SafeAreaView style={styles.container}>
      <Text style={styles.header}>ROOST</Text>
      <View style={styles.grid}>
        <TouchableOpacity 
          style={styles.box}
          onPress={() => navigation.navigate('Map')}
        >
          <Text style={styles.boxText}>Find Parking</Text>
        </TouchableOpacity>
      </View>
    </SafeAreaView>
  );
}

function MapScreen() {
  const [selectedLot, setSelectedLot] = useState(null);

  
  const mapBoundaries = {
    northEast: {
      latitude: 40.7470,   // Northmost point
      longitude: -74.0220, // Eastmost point
    },
    southWest: {
      latitude: 40.7420,   // Southmost point
      longitude: -74.0270, // Westmost point
    }
  };

  return (
    <View style={styles.container}>
      <MapView
        style={styles.map}
        initialRegion={{
          latitude: 40.7452,
          longitude: -74.0239,
          latitudeDelta: 0.01,
          longitudeDelta: 0.01,
        }}
        minZoomLevel={15}
        maxZoomLevel={20}
        mapPadding={{
          top: 50,
          right: 50,
          bottom: 50,
          left: 50
        }}
        region={{
          latitude: 40.7452,
          longitude: -74.0239,
          latitudeDelta: 0.01,
          longitudeDelta: 0.01,
        }}
        onRegionChangeComplete={(region) => {
          // Constrain latitude
          let newLatitude = region.latitude;
          if (region.latitude > mapBoundaries.northEast.latitude) {
            newLatitude = mapBoundaries.northEast.latitude;
          }
          if (region.latitude < mapBoundaries.southWest.latitude) {
            newLatitude = mapBoundaries.southWest.latitude;
          }
          
          // Constrain longitude
          let newLongitude = region.longitude;
          if (region.longitude > mapBoundaries.northEast.longitude) {
            newLongitude = mapBoundaries.northEast.longitude;
          }
          if (region.longitude < mapBoundaries.southWest.longitude) {
            newLongitude = mapBoundaries.southWest.longitude;
          }
        }}
        pitchEnabled={false}
        rotateEnabled={false}
        liteMode={false}
        moveOnMarkerPress={false}
      >
        {parkingLots.map((lot) => (
          <Marker
            key={lot.id}
            coordinate={lot.coordinate}
            title={lot.name}
            description={`Available: ${lot.available}/${lot.capacity}`}
            onPress={() => setSelectedLot(lot)}
          />
        ))}
      </MapView>

      {selectedLot && (
        <Modal
          animationType="slide"
          transparent={true}
          visible={!!selectedLot}
          onRequestClose={() => setSelectedLot(null)}
        >
          <View style={styles.modalView}>
            <Text style={styles.modalTitle}>{selectedLot.name}</Text>
            <Text style={styles.modalText}>
              Available Spaces: {selectedLot.available}/{selectedLot.capacity}
            </Text>
            <TouchableOpacity
              style={styles.modalButton}
              onPress={() => setSelectedLot(null)}
            >
              <Text style={styles.modalButtonText}>Close</Text>
            </TouchableOpacity>
          </View>
        </Modal>
      )}
    </View>
  );
}

const App = () => {
  return (
    <NavigationContainer>
      <Stack.Navigator>
        <Stack.Screen 
          name="Home" 
          component={HomeScreen}
          options={{ headerShown: false }}
        />
        <Stack.Screen 
          name="Map" 
          component={MapScreen}
          options={{ 
            title: 'Parking Map',
            headerStyle: {
              backgroundColor: '#8B0000',
            },
            headerTintColor: '#fff',
          }}
        />
      </Stack.Navigator>
    </NavigationContainer>
  );
};

